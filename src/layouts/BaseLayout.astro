---
import '../styles/global.css';
import { getLocaleFromUrl, getAlternateUrl, t } from '../i18n/utils';
import type { Locale } from '../i18n/utils';
import { LOCALES, LOCALE_META, DEFAULT_LOCALE } from '../i18n/locales';
import CookieBanner from '../components/CookieBanner.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  articleMeta?: {
    publishedTime: string;
    author?: string;
    tags?: string[];
    section?: string;
  };
  jsonLd?: object;
}

const locale = getLocaleFromUrl(Astro.url) as Locale;
const {
  title = t(locale, 'site.title'),
  description = t(locale, 'site.description'),
  ogImage = '/images/og-default.jpg',
  ogType = 'website',
  articleMeta,
  jsonLd,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const localeMeta = LOCALE_META[locale];
const alternateLinks = LOCALES.map((l) => ({
  hreflang: LOCALE_META[l].htmlLang,
  href: new URL(getAlternateUrl(Astro.url.pathname, l), Astro.site).href,
}));
const xDefaultHref = new URL(getAlternateUrl(Astro.url.pathname, DEFAULT_LOCALE), Astro.site).href;
---

<!doctype html>
<html lang={localeMeta.htmlLang} class="scroll-smooth">
  <head>
    <!-- Pick a language from the browser's setting on first visit to the
         unprefixed home page, unless the visitor already chose one via the
         language picker (kilc_lang cookie). Never overrides an explicit
         choice or a page the visitor navigated to directly. -->
    <script is:inline>
      (function () {
        try {
          if (window.location.pathname !== '/') return;
          if (document.cookie.indexOf('kilc_lang=') !== -1) return;
          var supported = ['en', 'zh', 'es', 'ms'];
          var prefixes = { zh: '/zh', es: '/es', ms: '/ms' };
          var langs = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || 'en'];
          var match = 'en';
          for (var i = 0; i < langs.length; i++) {
            var l = String(langs[i]).toLowerCase();
            var found = supported.find(function (s) { return l === s || l.indexOf(s + '-') === 0; });
            if (found) { match = found; break; }
          }
          if (prefixes[match]) window.location.replace(prefixes[match]);
        } catch (e) {}
      })();
    </script>

    <!-- Performance hints -->
    <link rel="preconnect" href="https://analytics.kilc.co.uk" />

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Canonical & hreflang (one per supported language, plus x-default) -->
    <link rel="canonical" href={canonicalUrl.href} />
    {alternateLinks.map((alt) => (
      <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={xDefaultHref} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Keane International Legal Consultancy" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={localeMeta.ogLocale} />
    {LOCALES.filter((l) => l !== locale).map((l) => (
      <meta property="og:locale:alternate" content={LOCALE_META[l].ogLocale} />
    ))}

    <!-- Article meta (blog posts only) -->
    {articleMeta && (
      <>
        <meta property="article:published_time" content={articleMeta.publishedTime} />
        {articleMeta.author && <meta property="article:author" content={articleMeta.author} />}
        {articleMeta.section && <meta property="article:section" content={articleMeta.section} />}
        {(articleMeta.tags ?? []).map(tag => <meta property="article:tag" content={tag} />)}
      </>
    )}

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site).href} />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon.ico?v=2" />

    <!-- RSS feed discovery -->
    <link rel="alternate" type="application/rss+xml" title="KILC Blog" href="/rss.xml" />

    <!-- JSON-LD: Organization (every page) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": ["Organization", "LegalService"],
      "name": "Keane International Legal Consultancy",
      "alternateName": "KILC",
      "url": "https://kilc.co.uk",
      "logo": "https://kilc.co.uk/images/general/kilc-logo-colour-transparent.png",
      "description": "Cross-border legal and compliance consultancy helping investors from around the world establish and operate in the UK",
      "areaServed": ["GB", "CN", "AR", "MY"],
      "serviceType": "Legal Consultancy"
    })} />

    <!-- JSON-LD: Page-specific (blog posts) -->
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}

    <!-- Umami analytics — loaded dynamically by CookieBanner after consent -->
  </head>
  <body>
    <slot />
    <CookieBanner locale={locale} />
    <script>
      const observer = new IntersectionObserver(
        (entries) => entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); observer.unobserve(e.target); } }),
        { threshold: 0.12 }
      );
      document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
    </script>
  </body>
</html>

---
import type { Locale } from '../i18n/utils';
import BilingualText from './BilingualText.astro';

interface Props {
  title: string;
  subtitle?: string;
  /** i18n keys — when set, title/subtitle render via BilingualText so bilingual mode can pair a second language. */
  titleKey?: string;
  subtitleKey?: string;
  backgroundImage?: string;
  backgroundVideo?: string;
  backgroundPosition?: string;
  cta?: { text: string; href: string };
  showCta?: boolean;
  locale: Locale;
}

const {
  title,
  subtitle,
  titleKey,
  subtitleKey,
  backgroundImage = '/images/hero/an-aerial-view-of-a-city-with-tall-buildings.jpg',
  backgroundVideo,
  backgroundPosition = 'center',
  cta,
  showCta = true,
  locale,
} = Astro.props;
---

<section class="relative min-h-[60vh] flex items-center justify-center overflow-hidden">
  <!-- Background: video (preferred) or image fallback -->
  {backgroundVideo ? (
    <div class="absolute inset-0">
      <video
        class="absolute inset-0 w-full h-full object-cover"
        autoplay
        muted
        loop
        playsinline
        poster={backgroundImage}
      >
        <source src={backgroundVideo} type="video/mp4" />
      </video>
      <div class="absolute inset-0 bg-black/35"></div>
    </div>
  ) : (
    <div
      class="absolute inset-0 bg-cover bg-no-repeat"
      style={`background-image: url('${backgroundImage}'); background-position: ${backgroundPosition};`}
    >
      <div class="absolute inset-0 bg-black/20"></div>
    </div>
  )}

  <!-- Content -->
  <div class="relative z-10 max-w-4xl mx-auto px-4 py-20 text-center text-white">
    {titleKey ? (
      <BilingualText path={titleKey} locale={locale} as="h1" class="text-4xl sm:text-5xl lg:text-6xl font-sans font-bold italic leading-tight mb-6" secondaryClass="block text-2xl sm:text-3xl font-sans italic opacity-80 mt-2" />
    ) : (
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-sans font-bold italic leading-tight mb-6">
        {title}
      </h1>
    )}
    {subtitleKey ? (
      <BilingualText path={subtitleKey} locale={locale} as="p" class="text-lg sm:text-xl text-white/90 max-w-2xl mx-auto mb-8" secondaryClass="block text-base text-white/70 max-w-2xl mx-auto mt-2 italic" />
    ) : subtitle && (
      <p class="text-lg sm:text-xl text-white/90 max-w-2xl mx-auto mb-8">
        {subtitle}
      </p>
    )}
    {showCta && cta && (
      <a
        href={cta.href}
        class="inline-block bg-gradient-to-r from-brand-primary to-brand-secondary text-white font-semibold px-8 py-3 rounded-lg hover:opacity-90 transition-opacity shadow-lg"
      >
        {cta.text}
      </a>
    )}
  </div>
</section>
